# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit the real .env — it's gitignored on purpose.
# In staging/production these same variable names are injected by the
# secrets manager / deploy pipeline, never read from a committed file.

# --- environment ---
ENVIRONMENT=local          # local | staging | production
DEBUG=true
LOG_LEVEL=DEBUG

# --- app ---
APP_NAME=MedDocAI
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-this-is-local-only
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=meddocai
POSTGRES_USER=meddocai
POSTGRES_PASSWORD=meddocai_local_only

# --- redis (cache + rate limiting only — not a task queue; Temporal owns
#     all background/durable execution) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- object storage (minio locally, real S3 in staging/production) ---
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=meddocai-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# --- temporal ---
TEMPORAL_HOST=temporal:7233

# --- host port mappings (local dev only; change if a port is already in use) ---
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
TEMPORAL_HOST_PORT=7233
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
TEMPORAL_UI_HOST_PORT=8080
REDISINSIGHT_HOST_PORT=5540
